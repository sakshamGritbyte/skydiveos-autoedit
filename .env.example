# Claude API — used by /edl to generate the Edit Decision List
ANTHROPIC_API_KEY=

# S3-compatible object store for raw + rendered media
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Celery broker / result backend. /ingest also LPUSHes ready_for_processing
# events onto a Redis list here; without it, events fall back to a local file.
REDIS_URL=redis://localhost:6379/0

# Media root. Holds two things:
#   - the dropzone's browsable jump archive (see ARCHIVE_ROOT below):
#       <root>/{jump date}/{instructor}/{customer}/{raw,edited,preview,photos}/
#   - the camera card mirror a pull stages into:
#       <root>/_camera-staging/{camera_id}/{date}/{filename}
RAW_STORAGE_ROOT=./raw-storage

# Jump archive (api/archive.py). Every job's raw footage and finished renders are
# mirrored into <ARCHIVE_ROOT>/{jump date}/{instructor}/{customer}/ so the dropzone can
# browse a jump by name instead of by job uuid. On by default; nothing reads from it, so
# turning it off only loses the browsable copy.
ARCHIVE_ENABLED=true
# Defaults to RAW_STORAGE_ROOT. Point it at a NAS/second volume to keep the archive off
# the working disk — cross-filesystem placement automatically falls back to copying.
ARCHIVE_ROOT=
# How archived files are materialised: "link" (hardlink — a 4K master costs no extra
# disk; the default), "copy" (independent copies), or "symlink".
ARCHIVE_LINK_MODE=link
# Record a sha256 per archived file in the jump's manifest.json, so an operator can
# prove the master they hold is the one that was ingested. Digests are cached per
# (size, mtime), so each file is read once no matter how many pipeline passes run.
# Turn off on a box where even that single read is too much I/O.
ARCHIVE_HASHES=true

# Card retention (ingest/retention.py). A dropzone SD card holds ~30 Ultimate jumps, so
# at 4–5 jumps/day it fills within a week — and a FULL CARD SILENTLY STOPS RECORDING
# mid-day, costing a customer their jump. With this on, the next pull deletes on-card
# files that S3 has already confirmed, keeping the card clear with nobody touching it.
# OFF by default: it destroys the camera's copy, so opt in per machine.
DELETE_AFTER_TRANSFER=false
# Grace period before a confirmed file may be deleted (hours). 24 = a day to notice a
# problem while the footage is still on the card. 0 deletes as soon as S3 confirms.
DELETE_AFTER_TRANSFER_MIN_AGE_H=24
# Log what cleanup WOULD delete and delete nothing. Run a full day like this before
# trusting deletion with real customer footage.
DELETE_AFTER_TRANSFER_DRY_RUN=false

# Deadline on the SDK's "wait for the camera to report itself idle" gate, in seconds
# (ingest/camera.py:_bound_camera_ready_wait). A GoPro that keeps starting recordings —
# QuikCapture firing on a bumped shutter — never reports idle, and the SDK's wait has no
# timeout, so an unattended pull parks forever with the BLE link up and nothing in the
# log. Bounded, it fails with an actionable error and the next scan retries. Raise it for
# a camera that legitimately needs longer to finish an encode.
GOPRO_READY_TIMEOUT_S=60

# Deadline for the camera to raise its WiFi access point, in seconds
# (ingest/camera.py:_retry_wifi_ap_wait). The SDK hardcodes 5 s and raises TimeoutError,
# which its own retry loop does not catch — so a HERO12 that needs longer fails the pull
# outright AND skips the enable_wifi_ap(False) reset, leaving the AP half-enabled so the
# next attempt fails identically. Patched, a slow AP retries with a clean reset between
# attempts. Raise it for a camera that is consistently slow to bring its AP up.
GOPRO_AP_READY_TIMEOUT_S=30

# SkydiveOS web layer — pipeline calls back here on job state changes
SKYDIVEOS_API_BASE=http://localhost:3000

# Camera auto-discovery (ingest/discovery.py). When ENABLE_AUTO_DISCOVERY is on,
# the API BLE-scans every DISCOVERY_INTERVAL_SECONDS for *paired* cameras (the
# allow-list in MongoDB) and auto-pulls + processes them. Off by default.
ENABLE_AUTO_DISCOVERY=false
DISCOVERY_INTERVAL_SECONDS=30
# Scanner / transport: "ble" (wireless: BLE scan + WiFi pull, real GoPros),
# "usb" (kiosk: mDNS detect a USB-connected GoPro + wired pull), or "static" — a
# no-hardware simulation that scans DISCOVERY_FAKE_CAMERAS and stages
# DISCOVERY_SAMPLE_MP4 in place of a real download. ble/usb need the hardware SDK.
CAMERA_SCANNER=ble
DISCOVERY_FAKE_CAMERAS=1234
DISCOVERY_SAMPLE_MP4=sample-data/discovery_sample.mp4
# How many clips each simulated camera reports in one pull (default 1). A real GoPro
# card holds many files, so bump this to stage e.g. 12 files from a single fake camera
# instead of needing 12 ids in DISCOVERY_FAKE_CAMERAS.
DISCOVERY_SAMPLE_COUNT=1
# MongoDB holding the paired-camera registry (the `cameras` collection). The
# mongodb+srv:// form needs pymongo[srv]/dnspython. Unset → registry disabled.
MONGO_URL=
MONGO_DB=skydiveos

# Enforce per-instructor access scoping using identity SkydiveOS forwards
# (X-Instructor-Id + X-Role headers). Off → every caller is treated as admin
# (open, back-compatible). Turn on once SkydiveOS forwards the headers.
ENFORCE_INSTRUCTOR_AUTH=false

# Use a validated GoPro LRV proxy for the ANALYSIS stages (GPMF parsing, scene
# segmentation, exit/freefall/canopy detection, face/smile/eye scoring) when one is
# present beside the master and passes validation (matching LRV, duration within 0.1s,
# readable video + GPMF). Any failure falls back to the MP4 transparently. Rendering,
# EDL application, photo extraction, and all deliverables ALWAYS use the original MP4.
# Off by default — analysis reads the MP4 exactly as today.
USE_PROXY_ANALYSIS=false

# ── Fully-automatic delivery (camera → edit → customer inbox, no human step) ──
# When AUTO_DELIVER is on, a finished render skips the instructor review gate:
# the job is auto-approved and delivery runs immediately — deliverables are
# uploaded to s3://$S3_BUCKET/deliveries/{job_id}/, presigned download links are
# generated, and the customer is emailed (needs customer_email on the job and the
# SMTP settings below). Off by default: the instructor still taps Approve.
AUTO_DELIVER=false

# SMTP transport for the delivery email (e.g. AWS SES: email-smtp.<region>.amazonaws.com:587,
# or any provider). Unset SMTP_HOST → no email is sent; the links are still generated
# and forwarded to SkydiveOS in the status callback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# From address on customer emails (falls back to SMTP_USER).
DELIVERY_FROM_EMAIL=
# Presigned-link lifetime in days (S3 SigV4 caps this at 7).
DELIVERY_LINK_TTL_DAYS=7

# ── Service token: WHO MAY TALK TO THIS API AT ALL ───────────────────────────
# Shared secret required as `Authorization: Bearer <token>` on every route except
# the customer gallery /j/{code}. Set it to the SAME value as SkydiveOS's
# AI_BACKEND_API_KEY / AUTO_EDIT_API_KEY — it already sends that header, so no code
# change is needed on either side.
#
# WHY THIS MATTERS: this service authenticates callers on the self-asserted
# X-Instructor-Id / X-Role headers, and with ENFORCE_INSTRUCTOR_AUTH off every
# caller is an admin. On a reachable deployment that means an anonymous stranger can
# list every customer's name/email/links, stream their video, and (with the paywall
# deployed) unlock a paid edit for free. UNSET = no gate: only safe if the service is
# unreachable from the internet.
AUTO_EDIT_API_KEY=

# Requests per minute per caller IP on the PUBLIC customer-gallery routes (/j/*).
# Everything else needs AUTO_EDIT_API_KEY, so this is the only surface a stranger can
# reach — and a locked page polls /j/{code}/state every 6 s, so the ceiling has to clear
# real traffic. Not what makes the link unguessable (the 65-bit short code is); this
# caps the cost of someone trying codes anyway. 0 disables.
# Behind a proxy, the real client is read from X-Forwarded-For — set it (the configs in
# deploy/PROXY_LOCKDOWN.md do), else every customer shares one bucket.
GALLERY_RATE_LIMIT_PER_MIN=300

# Public origin this API is served at for CUSTOMERS (e.g. https://freefall.ing).
# When set, the delivery email/callback carries the short, never-expiring gallery
# link {PUBLIC_BASE_URL}/j/{code} (served live by this API — locked previews flip to
# the clean video the moment /unlock is called) instead of uploading a presigned-URL
# gallery.html to S3. Unset → the legacy S3-hosted gallery (7-day links).
PUBLIC_BASE_URL=
# Price shown on the locked gallery's unlock button (display only — billing is
# SkydiveOS's; it calls POST /jobs/{id}/unlock after capturing payment).
PREVIEW_PRICE_DISPLAY=$39
# SkydiveOS checkout page for the unlock CTA, with {job_id}/{booking_id} placeholders
# (and {item} for an upsell tile — "unlock" for the CTA itself), e.g.
# https://ultimatedzm.com/unlock/{job_id}. Unset → the CTA and the upsell tiles are
# text-only ("ask at the desk") instead of dead links.
CHECKOUT_URL_TEMPLATE=

# The gallery's "Add to your day" upsell tiles, shown on BOTH the unlocked and the
# locked page (the row is the operator's second revenue line either way). One tile per
# "|", four ":"-separated fields per tile — key:title:blurb:price. The key is what
# {item} above receives; the blurb may be empty. Unset → the three defaults below;
# "off" → no upsell row at all. A malformed tile is skipped, never fatal.
UPSELL_TILES=raw:Raw Footage:Every unedited minute:$29|photos:Photo Pack:32 stills, full res:$19|rebook:Book Again:Repeat jumper discount:-15%

# Two-camera "Ultimate" job: seconds to wait for the SECOND camera's footage before a
# watchdog fails the job (instead of leaving it stuck in `queued`). Guards against a
# never-arriving second camera or a booking mis-mapped to the ultimum package.
ULTIMUM_SECOND_CAMERA_TIMEOUT_S=3600

# Shared secret sent on the status callback to SkydiveOS (X-Auto-Edit-Token header).
# Must match the AUTO_EDIT_CALLBACK_TOKEN SkydiveOS's status receiver verifies (if it
# enables the check). Unset → no token header sent (open callback).
AUTO_EDIT_CALLBACK_TOKEN=

# IANA timezone the GoPro cameras' clocks are set to (the dropzone's local time). GoPro
# writes LOCAL wall-clock into the MP4's creation_time and mislabels it UTC; discovery
# reinterprets it via this zone and sends a TRUE-UTC captured_at so SkydiveOS's DZ-local
# footage↔booking match lines up. Set to your dropzone's zone; unset only if the cameras'
# clocks are genuinely on UTC. Example (Canada, Eastern): America/Toronto
CAMERA_CLOCK_TZ=America/Toronto
