# Claude API — used by /edl to generate the Edit Decision List
ANTHROPIC_API_KEY=

# S3-compatible object store for raw + rendered media
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Celery broker / result backend. /ingest also LPUSHes ready_for_processing
# events onto a Redis list here; without it, events fall back to a local file.
REDIS_URL=redis://localhost:6379/0

# Where /ingest stages pulled camera media: <root>/{camera_id}/{date}/{filename}
RAW_STORAGE_ROOT=./raw-storage

# SkydiveOS web layer — pipeline calls back here on job state changes
SKYDIVEOS_API_BASE=http://localhost:3000

# Camera auto-discovery (ingest/discovery.py). When ENABLE_AUTO_DISCOVERY is on,
# the API BLE-scans every DISCOVERY_INTERVAL_SECONDS for *paired* cameras (the
# allow-list in MongoDB) and auto-pulls + processes them. Off by default.
ENABLE_AUTO_DISCOVERY=false
DISCOVERY_INTERVAL_SECONDS=30
# Scanner / transport: "ble" (wireless: BLE scan + WiFi pull, real GoPros),
# "usb" (kiosk: mDNS detect a USB-connected GoPro + wired pull), or "static" — a
# no-hardware simulation that scans DISCOVERY_FAKE_CAMERAS and stages
# DISCOVERY_SAMPLE_MP4 in place of a real download. ble/usb need the hardware SDK.
CAMERA_SCANNER=ble
DISCOVERY_FAKE_CAMERAS=1234
DISCOVERY_SAMPLE_MP4=sample-data/discovery_sample.mp4
# How many clips each simulated camera reports in one pull (default 1). A real GoPro
# card holds many files, so bump this to stage e.g. 12 files from a single fake camera
# instead of needing 12 ids in DISCOVERY_FAKE_CAMERAS.
DISCOVERY_SAMPLE_COUNT=1
# MongoDB holding the paired-camera registry (the `cameras` collection). The
# mongodb+srv:// form needs pymongo[srv]/dnspython. Unset → registry disabled.
MONGO_URL=
MONGO_DB=skydiveos

# Enforce per-instructor access scoping using identity SkydiveOS forwards
# (X-Instructor-Id + X-Role headers). Off → every caller is treated as admin
# (open, back-compatible). Turn on once SkydiveOS forwards the headers.
ENFORCE_INSTRUCTOR_AUTH=false

# Use a validated GoPro LRV proxy for the ANALYSIS stages (GPMF parsing, scene
# segmentation, exit/freefall/canopy detection, face/smile/eye scoring) when one is
# present beside the master and passes validation (matching LRV, duration within 0.1s,
# readable video + GPMF). Any failure falls back to the MP4 transparently. Rendering,
# EDL application, photo extraction, and all deliverables ALWAYS use the original MP4.
# Off by default — analysis reads the MP4 exactly as today.
USE_PROXY_ANALYSIS=false

# ── Fully-automatic delivery (camera → edit → customer inbox, no human step) ──
# When AUTO_DELIVER is on, a finished render skips the instructor review gate:
# the job is auto-approved and delivery runs immediately — deliverables are
# uploaded to s3://$S3_BUCKET/deliveries/{job_id}/, presigned download links are
# generated, and the customer is emailed (needs customer_email on the job and the
# SMTP settings below). Off by default: the instructor still taps Approve.
AUTO_DELIVER=false

# SMTP transport for the delivery email (e.g. AWS SES: email-smtp.<region>.amazonaws.com:587,
# or any provider). Unset SMTP_HOST → no email is sent; the links are still generated
# and forwarded to SkydiveOS in the status callback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# From address on customer emails (falls back to SMTP_USER).
DELIVERY_FROM_EMAIL=
# Presigned-link lifetime in days (S3 SigV4 caps this at 7).
DELIVERY_LINK_TTL_DAYS=7

# Two-camera "Ultimate" job: seconds to wait for the SECOND camera's footage before a
# watchdog fails the job (instead of leaving it stuck in `queued`). Guards against a
# never-arriving second camera or a booking mis-mapped to the ultimum package.
ULTIMUM_SECOND_CAMERA_TIMEOUT_S=3600

# Shared secret sent on the status callback to SkydiveOS (X-Auto-Edit-Token header).
# Must match the AUTO_EDIT_CALLBACK_TOKEN SkydiveOS's status receiver verifies (if it
# enables the check). Unset → no token header sent (open callback).
AUTO_EDIT_CALLBACK_TOKEN=

# IANA timezone the GoPro cameras' clocks are set to (the dropzone's local time). GoPro
# writes LOCAL wall-clock into the MP4's creation_time and mislabels it UTC; discovery
# reinterprets it via this zone and sends a TRUE-UTC captured_at so SkydiveOS's DZ-local
# footage↔booking match lines up. Set to your dropzone's zone; unset only if the cameras'
# clocks are genuinely on UTC. Example (Canada, Eastern): America/Toronto
CAMERA_CLOCK_TZ=America/Toronto
